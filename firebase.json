{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    },
    {
      "source": "functions_py",
      "codebase": "ai",
      "runtime": "python312",
      "ignore": [
        "venv",
        ".venv",
        "__pycache__",
        "*.pyc",
        ".pytest_cache",
        "tests",
        ".git"
      ]
    }
  ],
  "storage": {
    "rules": "storage.rules"
  }
}
