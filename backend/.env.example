# --- LLM ---
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini/gemini-2.5-flash-lite

# --- Web search (Tavily) ---
TAVILY_API_KEY=your-tavily-api-key-here

# --- Auth bypass for curl/Postman dev ---
# Send `Authorization: Admin <BACKEND_ADMIN_KEY>:<uid>` to skip Firebase verification.
BACKEND_ADMIN_KEY=change-me-long-random-string

# --- Firebase Admin SDK ---
# Pick ONE of the two options below:
#
# Option A (Railway / Render / Fly / Cloud Run friendly): paste the full
# service-account.json content as a single env var. Raw JSON or
# base64-encoded JSON both work. Easier than uploading a file.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...",...}'
#
# Option B (local dev): point at a file on disk. Add the file to .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# --- Firebase Storage bucket ---
BACKEND_STORAGE_BUCKET=academic-ally-app.appspot.com

# --- Misc ---
LOG_LEVEL=INFO

# Temporary presentation safeguard. When true, IT semesters 1 and 2 use
# deterministic demo responses instead of Gemini. Set false after AI quota is restored.
DEMO_FALLBACK_ENABLED=true
