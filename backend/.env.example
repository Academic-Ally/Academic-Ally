# --- LLM ---
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini/gemini-2.5-flash-lite

# --- Web search (Tavily) ---
TAVILY_API_KEY=your-tavily-api-key-here

# --- Auth bypass for curl/Postman dev ---
# Send `Authorization: Admin <BACKEND_ADMIN_KEY>:<uid>` to skip Firebase verification.
BACKEND_ADMIN_KEY=change-me-long-random-string

# --- Firebase Admin SDK (required for Bearer token verification) ---
# Path to a service-account JSON downloaded from Firebase console.
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json

# --- Misc ---
LOG_LEVEL=INFO
